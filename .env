EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyA1_YOUR_ACTUAL_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=://firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-kakao-app-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=://appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456:web:abcd1234

# Firestore path for AES secret key (value in Firestore must be: abcd1234abcd1234)
EXPO_PUBLIC_FIRESTORE_SECRET_COLLECTION=secrets
EXPO_PUBLIC_FIRESTORE_SECRET_DOCUMENT=encryption
EXPO_PUBLIC_FIRESTORE_SECRET_FIELD=aesKey

# Mock json-server — mobile-react-native-json-server (port 5000)
# iOS Simulator / Web: 127.0.0.1
# Android Emulator: http://10.0.2.2:5000/accounts
EXPO_PUBLIC_ACCOUNTS_API_URL=http://127.0.0.1:5000/accounts
EXPO_PUBLIC_ACCOUNTS_PER_PAGE=10
EXPO_PUBLIC_USER_DISPLAY_NAME=คุณลูกค้า
