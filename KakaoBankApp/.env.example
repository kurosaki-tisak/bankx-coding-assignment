# Copy to `.env` for local development (never commit `.env`).
# For CI / App Distribution builds, set the same keys as GitHub Actions secrets.
#
# Firebase native configs (also never commit real values):
#   cp firebase/google-services.json.example firebase/google-services.json
#   cp firebase/GoogleService-Info.plist.example firebase/GoogleService-Info.plist
#   # then paste real values from Firebase Console → Project settings → Your apps
#   # or: npx -y firebase-tools@latest apps:sdkconfig ANDROID|IOS <APP_ID>
#
# GitHub Actions secrets for native configs (full file contents):
#   FIREBASE_GOOGLE_SERVICES_JSON
#   FIREBASE_GOOGLE_SERVICE_INFO_PLIST
#
# Accounts API URL is loaded at runtime from Firestore:
#   secrets/endpoint → field `accounts`
# AES key is loaded at runtime from Firestore (never put aesKey in .env):
#   secrets/encryption → field `aesKey`
#
# After creating `.env`, restart Metro with a clean cache:
#   npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_FIRESTORE_SECRET_COLLECTION=secrets
EXPO_PUBLIC_FIRESTORE_SECRET_DOCUMENT=encryption
EXPO_PUBLIC_FIRESTORE_SECRET_FIELD=aesKey
